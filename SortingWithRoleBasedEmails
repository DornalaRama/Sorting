Option Explicit

'=== Helper: remove accents ===
Function RemoveAccents(ByVal s As String) As String
    If Len(s) = 0 Then
        RemoveAccents = s
        Exit Function
    End If
    
    s = Replace(s, "à", "a"): s = Replace(s, "á", "a")
    s = Replace(s, "â", "a"): s = Replace(s, "ã", "a")
    s = Replace(s, "ä", "a"): s = Replace(s, "å", "a")
    s = Replace(s, "À", "A"): s = Replace(s, "Á", "A")
    s = Replace(s, "Â", "A"): s = Replace(s, "Ã", "A")
    s = Replace(s, "Ä", "A"): s = Replace(s, "Å", "A")
    
    s = Replace(s, "è", "e"): s = Replace(s, "é", "e")
    s = Replace(s, "ê", "e"): s = Replace(s, "ë", "e")
    s = Replace(s, "È", "E"): s = Replace(s, "É", "E")
    s = Replace(s, "Ê", "E"): s = Replace(s, "Ë", "E")
    
    s = Replace(s, "ì", "i"): s = Replace(s, "í", "i")
    s = Replace(s, "î", "i"): s = Replace(s, "ï", "i")
    s = Replace(s, "Ì", "I"): s = Replace(s, "Í", "I")
    s = Replace(s, "Î", "I"): s = Replace(s, "Ï", "I")
    
    s = Replace(s, "ò", "o"): s = Replace(s, "ó", "o")
    s = Replace(s, "ô", "o"): s = Replace(s, "õ", "o")
    s = Replace(s, "ö", "o"): s = Replace(s, "ø", "o")
    s = Replace(s, "Ò", "O"): s = Replace(s, "Ó", "O")
    s = Replace(s, "Ô", "O"): s = Replace(s, "Õ", "O")
    s = Replace(s, "Ö", "O"): s = Replace(s, "Ø", "O")
    
    s = Replace(s, "ù", "u"): s = Replace(s, "ú", "u")
    s = Replace(s, "û", "u"): s = Replace(s, "ü", "u")
    s = Replace(s, "Ù", "U"): s = Replace(s, "Ú", "U")
    s = Replace(s, "Û", "U"): s = Replace(s, "Ü", "U")
    
    s = Replace(s, "ç", "c"): s = Replace(s, "Ç", "C")
    s = Replace(s, "ñ", "n"): s = Replace(s, "Ñ", "N")
    s = Replace(s, "ý", "y"): s = Replace(s, "ÿ", "y")
    s = Replace(s, "Ý", "Y")
    
    RemoveAccents = s
End Function

'=== Helper: collapse multiple spaces to single ===
Function SingleSpaces(ByVal s As String) As String
    Do While InStr(s, "  ") > 0
        s = Replace(s, "  ", " ")
    Loop
    SingleSpaces = Trim$(s)
End Function

'=== Helper: remove everything except letters and space ===
Function LettersAndSpacesOnly(ByVal s As String) As String
    Dim i As Long, ch As String, out As String
    For i = 1 To Len(s)
        ch = Mid$(s, i, 1)
        If (ch >= "A" And ch <= "Z") Or (ch >= "a" And ch <= "z") Or ch = " " Then
            out = out & ch
        End If
    Next i
    LettersAndSpacesOnly = out
End Function

'=== Helper: check if email is role-based ===
Function IsRoleBasedEmail(ByVal emailText As String) As Boolean
    Dim localPart As String
    Dim atPos As Long
    Dim rolePrefixes As Variant
    Dim i As Long
    
    emailText = LCase(Trim$(emailText))
    
    If Len(emailText) = 0 Then
        IsRoleBasedEmail = False
        Exit Function
    End If
    
    atPos = InStr(1, emailText, "@")
    If atPos <= 1 Then
        IsRoleBasedEmail = False
        Exit Function
    End If
    
    localPart = Left$(emailText, atPos - 1)
    
    rolePrefixes = Array( _
        "admin", "administrator", "info", "sales", "support", "contact", _
        "help", "hello", "hi", "team", "office", "marketing", "mail", _
        "email", "enquiry", "enquiries", "inquiry", "inquiries", _
        "feedback", "customerservice", "customer.service", "custserv", _
        "service", "billing", "accounts", "accounting", "payments", _
        "hr", "jobs", "careers", "recruitment", "newsletter", "news", _
        "press", "media", "webmaster", "postmaster", "hostmaster", _
        "abuse", "security", "privacy", "legal", "compliance", _
        "noreply", "no-reply", "donotreply", "do-not-reply", _
        "default", "staff", "members", "membership", "editor", _
        "editors", "submission", "submissions" _
    )
    
    For i = LBound(rolePrefixes) To UBound(rolePrefixes)
        If localPart = rolePrefixes(i) Then
            IsRoleBasedEmail = True
            Exit Function
        End If
    Next i
    
    IsRoleBasedEmail = False
End Function

