Sub CleanNamesAndEmails()
    Dim ws As Worksheet
    Dim lastRow As Long
    Dim r As Long
    Dim txt As String
    
    '=== SETTINGS: change if needed ===
    Const nameCol As String = "A"   'Names column
    Const mailCol As String = "B"   'Emails column
    Const headerRow As Long = 1     'Data starts from headerRow+1
    
    Set ws = ActiveSheet

    FixMojibake
    
    lastRow = ws.Cells(ws.Rows.Count, nameCol).End(xlUp).Row
    If lastRow <= headerRow Then Exit Sub
    
    Application.ScreenUpdating = False
    
    For r = lastRow To headerRow + 1 Step -1
        
        '----- NAMES COLUMN RULES -----
        txt = ws.Cells(r, nameCol).Value
        
        txt = RemoveAccents(txt)
        txt = LettersAndSpacesOnly(txt)
        txt = Replace(txt, " Jr", "", , , vbTextCompare)
        txt = Replace(txt, "Dr ", "", , , vbTextCompare)
        txt = Replace(txt, "Professor ", "", , , vbTextCompare)
        txt = Replace(txt, "Mr ", "", , , vbTextCompare)
        txt = Replace(txt, "Prof ", "", , , vbTextCompare)
        txt = Replace(txt, "Ms ", "", , , vbTextCompare)
        txt = SingleSpaces(txt)
        txt = StrConv(txt, vbProperCase)
        
        ws.Cells(r, nameCol).Value = txt
        
        '----- EMAIL COLUMN RULES -----
        txt = ws.Cells(r, mailCol).Value
        
        txt = Replace(txt, "e-mail:", "", , , vbTextCompare)
        txt = Replace(txt, "email:", "", , , vbTextCompare)
        txt = Replace(txt, "mail:", "", , , vbTextCompare)
        txt = Replace(txt, "(link send email)", "", , , vbTextCompare)
        
        txt = Replace(txt, "[", "")
        txt = Replace(txt, "]", "")
        txt = Replace(txt, "(", "")
        txt = Replace(txt, ")", "")
        
        txt = Replace(txt, " (at) ", "@", , , vbTextCompare)
        txt = Replace(txt, " at ", "@", , , vbTextCompare)
        txt = Replace(txt, "(at)", "@", , , vbTextCompare)
        txt = Replace(txt, "[at]", "@", , , vbTextCompare)
        txt = Replace(txt, " DOT ", ".", , , vbTextCompare)
        txt = Replace(txt, " dot ", ".", , , vbTextCompare)
        
        txt = Replace(txt, ":", "")
        txt = Replace(txt, ";", "")
        txt = Replace(txt, "%20", "")
        txt = Replace(txt, "&20", "")
        
        txt = SingleSpaces(txt)
        txt = LCase(txt)
        
        ws.Cells(r, mailCol).Value = txt
        
        '----- REMOVE ROLE-BASED EMAIL ROW -----
        If IsRoleBasedEmail(txt) Then
            ws.Rows(r).Delete
        End If
    Next r
    
    Application.ScreenUpdating = True
End Sub
